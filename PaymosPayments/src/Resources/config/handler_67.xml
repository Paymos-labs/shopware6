<?xml version="1.0" ?>
<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd">

    <!--
        Payment handler for Shopware 6.7+ (AbstractPaymentHandler).

        6.7 dropped the ".async" suffix: every handler now carries the single
        "shopware.payment.method" tag and the registry resolves a payment method's
        handlerIdentifier against the tagged service ids.

        NOT auto-loaded — see the note in handler_legacy.xml. PaymosPayments::build()
        loads exactly one of the two.
    -->
    <services>
        <service id="PaymosPayments\Service\PaymosPaymentHandler67">
            <argument type="service" id="PaymosPayments\Service\CheckoutProcessor"/>
            <argument type="service" id="PaymosPayments\Service\ShopwareGateway"/>
            <argument type="service" id="Shopware\Core\System\SystemConfig\SystemConfigService"/>
            <argument type="service" id="logger"/>
            <argument type="service" id="PaymosPayments\Service\CredentialStore"/>
            <tag name="shopware.payment.method"/>
        </service>
    </services>
</container>
